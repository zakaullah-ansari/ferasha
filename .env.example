# ---------------------------------------------------------------------------
# Ferasha monorepo environment. Copy to .env and replace every secret value.
# ---------------------------------------------------------------------------

# PostgreSQL 16
POSTGRES_DB=ferasha
POSTGRES_USER=ferasha
POSTGRES_PASSWORD=ferasha_dev_password

# Django (backend-core)
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-64
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend-core
DATABASE_URL=postgresql://ferasha:ferasha_dev_password@localhost:5432/ferasha
REDIS_URL=redis://localhost:6379/0

# Shared JWT signing key. Django signs, ai-engine verifies. MUST match.
# Minimum 32 bytes (RFC 7518 s.3.2) - the app refuses to boot otherwise.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me-shared-hs256-signing-key-min-32-bytes-long

# Service-to-service secret for internal callbacks (ai-engine -> backend-core)
AI_ENGINE_SHARED_SECRET=change-me-internal-shared-secret

# Cross origin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: LangChain agentic workflows
OPENAI_API_KEY=

# Frontend
BACKEND_CORE_URL=http://localhost:8000
AI_ENGINE_URL=http://localhost:8001
